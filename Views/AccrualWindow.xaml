<Window x:Class="NashDom.Views.AccrualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Начисление на лицевой счет" 
        Height="380" 
        Width="450"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Добавление начисления" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Лицевой счет:" Margin="0,0,0,5"/>
            <ComboBox x:Name="AccountCombo" DisplayMemberPath="AccountNumber" Height="30"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Сумма начисления (руб.):" Margin="0,0,0,5"/>
            <TextBox x:Name="AmountBox" Height="30"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Описание (необязательно):" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>
        
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Дата начисления:" Margin="0,0,0,5"/>
            <DatePicker x:Name="AccrualDatePicker" Height="30"/>
        </StackPanel>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Добавить" Width="100" Height="35" Margin="5" 
                    Click="AddButton_Click" Background="#007ACC" Foreground="White"/>
            <Button Content="Отмена" Width="100" Height="35" Margin="5" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>